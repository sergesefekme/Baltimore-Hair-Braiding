# Booking form backend (Supabase project "mirabelle-b-booking", us-east-1).
# Copy to .env and fill in. Vite only exposes VITE_-prefixed vars to the bundle.
#
# The anon/publishable key is PUBLIC — it ships inside the JS bundle. That is
# fine only while booking_requests grants anon INSERT and nothing else.
# Never put the service_role key in this file or anywhere under src/.

VITE_SUPABASE_URL=https://dqglhppksyhekaflnyop.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Edge function secrets (set with `supabase secrets set`, NOT here) ---
# These are listed for reference only. They live in Supabase, never in the
# bundle, because the Resend key can send mail as you.
#   BOOKING_NOTIFY_TO=kamgamirabelle4@gmail.com
#   RESEND_API_KEY=re_xxx
#
# No sending domain yet, so mail goes out from Resend's shared
# onboarding@resend.dev. That sender only delivers to the address that owns
# the Resend account — so sign up at resend.com using
# kamgamirabelle4@gmail.com, not any other address.
